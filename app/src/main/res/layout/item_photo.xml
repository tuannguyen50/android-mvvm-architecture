<!-- Tuan Thanh Nguyen modified this file. -->

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="photoModel"
            type="tuanthanhnguyen.androidmvvmarchitecture.ui.model.PhotoModel" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/grid_photo_item_card_corner_radius"
        app:elevation="@dimen/grid_photo_item_card_elevation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/photo_app_compat_image_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitCenter"
                app:layout_constraintDimensionRatio="H,4:3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:photoUrl="@{photoModel.photoUrlsModel.small}" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/user_name_app_compat_text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@color/thirty_five_percentage_transparent_black"
                android:paddingStart="@dimen/padding_start_and_padding_end_user_name_text_in_grid_photo_item"
                android:paddingTop="@dimen/padding_top_and_padding_bottom_user_name_text_in_grid_photo_item"
                android:paddingEnd="@dimen/padding_start_and_padding_end_user_name_text_in_grid_photo_item"
                android:paddingBottom="@dimen/padding_top_and_padding_bottom_user_name_text_in_grid_photo_item"
                android:text="@{photoModel.userModel.name}"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="@android:color/white"
                app:layout_constraintBottom_toBottomOf="@+id/photo_app_compat_image_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>